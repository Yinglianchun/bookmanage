<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.kmbeast.mapper.ReaderProposalMapper">

    <insert id="save">
        INSERT INTO reader_proposal (
            user_id,
            content,
            is_publish,
            reply_content,
            reply_time,
            create_time
        ) VALUES (
            #{userId},
            #{content},
            #{isPublish},
            #{replyContent},
            #{replyTime},
            #{createTime}
        )
    </insert>

    <update id="update">
        UPDATE reader_proposal
        <set>
            <if test="isPublish != null">
                is_publish = #{isPublish},
            </if>
            <if test="content != null and content != ''">
                content = #{content},
            </if>
            <if test="replyContent != null and replyContent != ''">
                reply_content = #{replyContent},
            </if>
            <if test="replyTime != null">
                reply_time = #{replyTime},
            </if>

        </set>
        WHERE id = #{id}
    </update>

    <delete id="batchDelete" parameterType="list">
        DELETE FROM reader_proposal WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="query" resultMap="BaseResultMap">

        SELECT rp.*, u.user_name
        FROM reader_proposal rp
        Left Join user u on rp.user_id = u.id
        <where>
            <if test="userName != null and userName !=''">
                u.user_name Like concat('%',#{userName},'%')
            </if>
            <if test="content != null and content !=''">
                rp.content Like concat('%',#{content},'%')
            </if>
            <if test="startTime != null and endTime != null">
                AND rp.create_time BETWEEN #{startTime} AND #{endTime}
            </if>
           
        </where>
        ORDER BY rp.create_time DESC
        <if test="current != null and size != null">
            LIMIT #{current}, #{size}
        </if>
    </select>

    <select id="queryCount" resultType="integer">

        SELECT COUNT(*)
        FROM reader_proposal rp
        Left Join user u on rp.user_id = u.id
        <where>
            <if test="userName != null and userName !=''">
                u.user_name Like concat('%',#{userName},'%')
            </if>
            <if test="content != null and content !=''">
                rp.content Like concat('%',#{content},'%')
            </if>
            <if test="startTime != null and endTime != null">
                AND rp.create_time BETWEEN #{startTime} AND #{endTime}
            </if>
          
        </where>

    </select>

    <resultMap id="BaseResultMap" type="cn.kmbeast.pojo.vo.ReaderProposalVO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="is_publish" property="isPublish"/>
        <result column="reply_content" property="replyContent"/>
        <result column="reply_time" property="replyTime"/>
        <result column="create_time" property="createTime"/>
        <result column="user_name" property="userName"/>
    </resultMap>

</mapper>
